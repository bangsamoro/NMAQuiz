# Reference only — the real `.env` already exists on the server (this app
# is live), with its PORT already chosen by Webuzo's Node.js App Manager /
# whoever first set this up. Don't regenerate it from this file; this just
# documents what should be in it. If you ever do need to recreate it from
# scratch, PORT must match whatever Webuzo's Node.js App Manager panel has
# configured for this app (it manages the reverse proxy side of that
# pairing — an arbitrary port here won't be reachable).
#
# ADMIN_PASSCODE is retired — admin login is now per-user (admin_users
# table + bcrypt), not a single shared env var. See
# scripts/seed-admin-users.js to create/reset an account.
PORT=3001

# From the existing DB dump — the app and MySQL run on the same box (typical
# for cPanel), so DB_HOST/DB_PORT are almost certainly right as-is. DB_NAME
# matches the live database this app already uses; only DB_USER/DB_PASSWORD
# (its real MySQL credentials, not in the dump) need filling in.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=sulutions_cloud_NMAWebinar_DB
